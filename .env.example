# Copy to .env and fill in. Never commit .env.

# ---------------------------------------------------------------------------
# Google Cloud
# ---------------------------------------------------------------------------
GOOGLE_CLOUD_PROJECT=agentic-hack-2026
GOOGLE_CLOUD_LOCATION=us-central1

# ⚠️ THIS FILE IS COMMITTED. Never put a real key here - put it in .env, which is
# gitignored. Everything below is a placeholder.
#
# Pick exactly ONE of the two auth modes:
#
# (A) Gemini API key - free tier, no billing account. Best for local development.
#     Set GOOGLE_API_KEY and leave GOOGLE_GENAI_USE_ENTERPRISE unset or False.
# GOOGLE_API_KEY=your-key-here
#
# (B) Vertex AI - needs a billing-enabled project. Use this on Cloud Run.
#     Set GOOGLE_GENAI_USE_ENTERPRISE=True and authenticate with:
#       gcloud auth application-default login
#     NOTE: in 2026 this variable replaced the older GOOGLE_GENAI_USE_VERTEXAI.
# GOOGLE_GENAI_USE_ENTERPRISE=True
#
# Setting both is a misconfiguration - the SDK will route to Vertex and ignore the key.

# ---------------------------------------------------------------------------
# Models - see docs/08-TECH-REFERENCE.md. gemini-3.5-pro does NOT exist.
# ---------------------------------------------------------------------------
NIGHTSHIFT_MODEL_REASONING=gemini-3.6-flash
NIGHTSHIFT_MODEL_FILTER=gemma-4-26b-a4b-it

# ---------------------------------------------------------------------------
# GitHub - least privilege.
# The token must be scoped to repositories YOU own. Nightshift refuses to open pull
# requests against anything outside NIGHTSHIFT_REPO_ALLOWLIST; see src/nightshift/policy.py.
# ---------------------------------------------------------------------------
GITHUB_TOKEN=
GITHUB_ACTOR=

# Comma-separated "owner/name" targets. Own repos or your own forks only.
NIGHTSHIFT_REPO_ALLOWLIST=

# ---------------------------------------------------------------------------
# Advisory sources
# ---------------------------------------------------------------------------
# OSV.dev needs no auth. NVD works without a key but is heavily rate-limited;
# a free key raises the limit: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# ---------------------------------------------------------------------------
# Safety rails
# ---------------------------------------------------------------------------
# Nothing is written to GitHub while this is true. Leave it on until you have
# watched a full run end to end.
NIGHTSHIFT_DRY_RUN=true

# Hard ceiling on PRs opened per run, so a bug cannot flood a repository.
NIGHTSHIFT_MAX_PRS_PER_RUN=5

# Bound the Patcher/Verifier critique loop.
NIGHTSHIFT_MAX_PATCH_ATTEMPTS=3
