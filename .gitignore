# Secrets — never commit. If one leaks, deleting the file does NOT remove it from git history:
# rotate the credential.
.env
.env.*
!.env.example
*-service-account*.json
service-account*.json
credentials.json
client_secret*.json
# Firebase downloads admin keys as <project>-firebase-adminsdk-<hash>.json, which none of
# the patterns above match.
*firebase-adminsdk*.json
*-adminsdk-*.json
# Catch-all for anything that reads like a key. Better a false positive than a leaked
# credential in a public repository.
*serviceaccount*.json
gcp-key*.json
key.json

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Local run artifacts
.nightshift/
runs/
*.log

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
